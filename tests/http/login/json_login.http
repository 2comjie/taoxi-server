@baseUrl = http://127.0.0.1:8080

### 首次游客登录：guest_id 为空时由服务端生成
POST {{baseUrl}}/api/login
Content-Type: application/json
format: 1
lang: zh-CN

{
  "login_type": 1,
  "guest_id": ""
}

> {%
    client.test("首次游客登录成功", function () {
        client.assert(response.status === 200, "HTTP状态码不是200");
        client.assert(response.body.code === 200, "业务状态码不是200");
        client.assert(response.body.result.openid, "响应中没有openid");
    });
    client.global.set("guestId", response.body.result.openid);
%}

### 已有游客再次登录：使用上一个请求返回的 openid
POST {{baseUrl}}/api/login
Content-Type: application/json
format: 1
lang: zh-CN

{
  "login_type": 1,
  "guest_id": "{{guestId}}"
}

> {%
    client.test("已有游客登录成功", function () {
        client.assert(response.status === 200, "HTTP状态码不是200");
        client.assert(response.body.code === 200, "业务状态码不是200");
        client.assert(response.body.result.is_register === false, "不应重复注册账号");
    });
%}
